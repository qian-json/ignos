# Copy to .env.local for local dev. Never commit real values.
# In production, set these in Vercel: Project > Settings > Environment Variables.

# Gemini API key for /api/ask (Google AI Studio). Without it the endpoint answers 503
# not_configured, or a stub flagged as mock on Vercel preview/development deployments or when
# ASK_ALLOW_STUB=1.
GEMINI_API_KEY=

# Optional: a second key, tried once if the main key's request fails (key rejected, server error,
# network error). Never committed; set it in Vercel like the main key.
GEMINI_API_KEY_BACKUP=

# Optional: set to 1 to also use the backup key when the main key hits a rate limit or daily quota (429).
# Off by default: spreading traffic over keys to get past a quota can count as quota circumvention.
GEMINI_BACKUP_ON_QUOTA=

# Optional: the Gemini model /api/ask uses (default gemini-3.5-flash-lite).
GEMINI_MODEL=

# Set to 1 in .env.local to get the /api/ask stub locally while there is no key. Never set it
# in production.
ASK_ALLOW_STUB=
